; Engine configuration file.
; 第 05 章 demo 项目入口

config_version=5

[application]

config/name="05 GDScript Syntax"
config/description="第 05 章 demo：GDScript 语法速查——按数字键 1~8 切换演示类别，Output 面板看运行结果。"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.102, 0.102, 0.102, 1)