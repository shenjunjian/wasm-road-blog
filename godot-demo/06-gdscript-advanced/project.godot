; Engine configuration file.
; 第 06 章 demo 项目入口

config_version=5

[application]

config/name="06 GDScript Advanced"
config/description="第 06 章 demo：信号 + Autoload + 场景切换 + UI 联动综合示例。"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

